# Copy to .env (mode 600, owned by apache on the server).
CLAMS_BASE_URL=https://cla.ms
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLAMS_SECRET_KEY=
CLAMS_DB_HOST=127.0.0.1
CLAMS_DB_NAME=clams
CLAMS_DB_USER=clams
CLAMS_DB_PASSWORD=

# Optional — each feature stays hidden until its values are set.
CLAMS_GOOGLE_CLIENT_ID=
CLAMS_GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, e.g. ms.cla.web
CLAMS_APPLE_CLIENT_ID=
CLAMS_APPLE_TEAM_ID=
CLAMS_APPLE_KEY_ID=
CLAMS_APPLE_PRIVATE_KEY_PATH=/var/www/html/clams/secrets/apple-signin.p8
CLAMS_RESEND_API_KEY=
CLAMS_MAIL_FROM=Clams <hello@cla.ms>
CLAMS_SAFE_BROWSING_KEY=

# Abuse limits for visitors without an account (0 = off).
CLAMS_ANON_LINKS_PER_HOUR=30
CLAMS_LOGIN_ATTEMPTS_PER_15MIN=10
